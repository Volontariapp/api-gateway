# 1. BASE : Environnement commun
FROM node:24-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable && corepack prepare yarn@4.12.0 --activate

# 2. RUNNER : Installation des dépendances et exécution des tests
FROM base AS runner

# On copie tout le projet car les tests E2E ont besoin des sources, 
# des fichiers de config et des tests eux-mêmes.
COPY . .

# On s'assure que les certificats sont présents (générés par scripts/generate-certs.sh)
# Note: Si ils ne sont pas générés localement, le build échouera ici

# Installation de TOUTES les dépendances (y compris devDeps pour Jest et ts-jest)
RUN yarn install --immutable

# Variables d'environnement par défaut pour les tests
ENV NODE_ENV=test
# Si cette variable est fournie, les tests cibleront cette URL plutôt que l'instance locale
ENV E2E_TARGET_URL=http://api-gateway:3000

# Par défaut, on lance les tests E2E
# --runInBand est souvent nécessaire pour les tests E2E afin d'éviter les collisions de données
CMD ["yarn", "test:e2e"]
